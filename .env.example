# Django settings
SECRET_KEY=your-secret-key-here
DEBUG=False

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=your-ec2-ip-here

# HTTPS/security settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_PROXY_SSL_HEADER_ENABLED=True

# Optional dotted-path callable for upload malware scanning
UPLOAD_MALWARE_SCANNER=

# Microsoft Entra internal API authentication
ENTRA_TENANT_ID=your-tenant-id
ENTRA_AUDIENCE=api://your-threatmodel-api-client-id
ENTRA_REQUIRED_ROLES=ThreatModel.Submit,ThreatModel.Admin

# AWS S3 (for media/evidence storage - uses IAM instance profile, no keys needed)
AWS_STORAGE_BUCKET_NAME=your-bucket-name-here
AWS_S3_REGION_NAME=us-east-1

# Database (RDS PostgreSQL)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_NAME=threatmodel
DB_USER=threatmodel
DB_PASSWORD=your-db-password-here
DB_PORT=5432
